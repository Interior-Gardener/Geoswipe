# =========================================================================
# GeoSwipe - Environment Variables Example
# =========================================================================
# DO NOT PUT REAL SECRETS IN THIS FILE. Variable NAMES only.
#
# SPLIT OF RESPONSIBILITY (this is a security boundary, not a style choice):
#
#   server/.env   - every credential. Never prefixed with VITE_.
#   client/.env.* - public configuration ONLY. Vite compiles VITE_* variables
#                   into the browser bundle, so anything there is world-readable.
#
# The browser reaches third-party services through server proxy endpoints
# (/api/ai, /api/weather, /api/maps, /api/news) so no key is ever shipped
# to a client.
# =========================================================================

# ---------------- SERVER (server/.env) - SECRET ----------------

# Database
MONGODB_URI=

# Third-party API keys - server-side only
# Groq chat model. If the AI returns "model_not_found", query
# GET /api/ai/status for models available to this account.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
MAPTILER_API_KEY=
OPENWEATHER_API_KEY=
NEWSAPI_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Server configuration
PORT=3000
# Default 127.0.0.1. Use 0.0.0.0 only when the host must accept external
# traffic (e.g. inside a container behind a reverse proxy).
HOST=127.0.0.1
NODE_ENV=development
# Comma-separated browser origins allowed to call the API. REQUIRED in
# production - an empty list rejects every browser origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Shared secret the Python gesture detector uses to register as a worker.
# Required in production: without it, any connecting client could register as
# a gesture worker and receive users' webcam frames.
GESTURE_WORKER_TOKEN=
# Allows a locally-run detector (CAMERA_MODE=local) to broadcast hand-position
# results when there is no originating browser tab. Leave false otherwise.
GESTURE_ALLOW_BROADCAST=false

# ---------------- CLIENT (client/.env.development) - PUBLIC ----------------
# Never add a credential below this line.

VITE_API_URL=http://localhost:3000
VITE_NODE_ENV=development
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_DEBUG_MODE=false
VITE_ENABLE_ANALYTICS=false

# ---------------- GESTURE CONTROL (gesture-control/.env) ----------------

SOCKET_SERVER_URL=http://localhost:3000
# Must match GESTURE_WORKER_TOKEN in server/.env
GESTURE_WORKER_TOKEN=
CAMERA_MODE=browser
MIN_DETECTION_CONFIDENCE=0.7
MIN_TRACKING_CONFIDENCE=0.7
