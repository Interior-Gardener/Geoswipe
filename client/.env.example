# Environment Configuration for GeoSwipe

# API Configuration
VITE_API_URL=http://localhost:3000
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# Development
VITE_NODE_ENV=development

# Production (uncomment and modify for production)
# VITE_API_URL=https://your-production-domain.com
# VITE_NODE_ENV=production

# Optional: Performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Optional: Debug mode
VITE_DEBUG_MODE=false

# Optional: Enable analytics
VITE_ENABLE_ANALYTICS=false

#Api key for groq chatbot
VITE_GROQ_CHATBOT_API_KEY=your_groq_chatbot_api_key_here

#apI KEY FOR openweathermap REAL TIME WEATHER API
VITE_OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

#Api key for newsapi
VITE_NEWSAPI_API_KEY = your_newsapi_api_key_here