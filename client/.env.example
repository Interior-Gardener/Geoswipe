# GeoSwipe - CLIENT environment (example)
#
# ============================================================================
# SECURITY: EVERY VARIABLE IN THIS FILE IS PUBLIC.
#
# Vite compiles VITE_* variables into the JavaScript bundle it serves to the
# browser. Anything placed here can be read by any visitor via DevTools or by
# downloading the bundle. NEVER put an API key, token, secret or connection
# string in this file.
#
# Third-party credentials (MapTiler, Groq, OpenWeather, NewsAPI, Unsplash) live
# in server/.env and are reached through the server proxy endpoints:
#   /api/ai/chat        - Groq
#   /api/weather/*      - OpenWeatherMap
#   /api/maps/*         - MapTiler
#   /api/news/*         - NewsAPI
# ============================================================================

# Base URL of the GeoSwipe API server.
VITE_API_URL=http://localhost:3000

# Development flags (non-sensitive).
VITE_NODE_ENV=development
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_DEBUG_MODE=false
VITE_ENABLE_ANALYTICS=false
