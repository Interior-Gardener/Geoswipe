# GeoSwipe - Gesture control configuration

# Socket.IO server URL
SOCKET_SERVER_URL=http://localhost:3000

# Shared secret proving this process is the trusted gesture detector.
# Must match GESTURE_WORKER_TOKEN in server/.env. Without a matching value the
# server will not route webcam frames to this worker.
GESTURE_WORKER_TOKEN=

# 'browser' (frames streamed from the web app) or 'local' (this machine's webcam)
CAMERA_MODE=browser

# Detection settings
MIN_DETECTION_CONFIDENCE=0.7
MIN_TRACKING_CONFIDENCE=0.7

# Debug webcam capture: never write a user image to disk unless debugging
SAVE_DEBUG_FRAME=false
