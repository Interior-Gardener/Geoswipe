# Gesture Control Configuration

# Socket.IO Server URL
SOCKET_SERVER_URL=http://localhost:3000

# Camera Mode: 'browser' (browser-based camera) or 'local' (cv2.VideoCapture)
# Use 'browser' for web deployment, 'local' for standalone testing
CAMERA_MODE=browser

# Detection Settings (optional)
# Lower values (0.3-0.5) = more sensitive, easier to detect hands in poor lighting
# Higher values (0.7-0.9) = stricter, requires clear hand visibility
MIN_DETECTION_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5
