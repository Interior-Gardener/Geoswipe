{
  "name": "geo-game",
  "private": true,
  "scripts": {
    "start:client": "cd client && npm run dev",
    "start:server": "cd server && node index.js",
    "start:gesture": "cd gesture-control && .\\venv\\Scripts\\python.exe detect.py",
    "start": "concurrently --names \"CLIENT,SERVER,GESTURE\" --prefix-colors \"cyan,green,yellow\" \"npm run start:client\" \"npm run start:server\" \"npm run start:gesture\"",
    "kill-ports": "npx kill-port 3000 5173"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  },
  "dependencies": {
    "dat.gui": "^0.7.9",
    "earcut": "^3.0.2",
    "mongoose": "^8.17.1",
    "react-router-dom": "^7.8.0",
    "three": "^0.179.1"
  }
}