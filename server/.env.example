# =========================================================================
# GeoSwipe - SERVER Environment Example
# =========================================================================
# DO NOT PUT REAL SECRETS IN THIS FILE. Variable NAMES only.
#
# SPLIT OF RESPONSIBILITY (this is a security boundary, not a style choice):
#
#   server/.env   - every credential. Never prefixed with VITE_.
#   client/.env.* - public configuration ONLY. Vite compiles VITE_* variables
#                   into the browser bundle, so anything there is world-readable.
#
# The browser reaches third-party services through server proxy endpoints
# (/api/ai, /api/weather, /api/maps, /api/news) so no key is ever shipped
# to a client.
# =========================================================================

# ---------------- SERVER (server/.env) - SECRET ----------------

# Database
MONGODB_URI=

# ---------------- Third-party API keys ----------------
#
# KEY POOLING: every free tier below is metered PER ACCOUNT, so keys from
# several free accounts pooled together multiply the daily allowance. Each
# service accepts either form:
#
#   OPENWEATHER_API_KEY=abc            <- single key
#   OPENWEATHER_API_KEYS=abc,def,ghi   <- pool, comma-separated
#
# Both may be set; they are merged and de-duplicated. The server uses them
# round-robin and automatically rotates to the next key when one returns 429
# (quota exhausted), so a single exhausted account does not break a feature.
#
# IMPORTANT: pooling is the SECOND line of defence. The first is caching -
# weather, news, map styles and safe-place lookups are cached and shared across
# all users (see server/services/cache.js), which is what actually keeps usage
# inside the free tiers as traffic grows. Do not treat extra keys as a
# substitute for the cache.

# Groq chat model. If the AI returns "model_not_found", query
# GET /api/ai/status for models available to this account.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_API_KEYS=

# MapTiler - 100,000 requests/month per account. Highest-volume integration
# (map tiles), so pooling helps most here.
MAPTILER_API_KEY=
MAPTILER_API_KEYS=

# OpenWeather - 1,000 calls/day per account. Cached for 4h per location.
OPENWEATHER_API_KEY=
OPENWEATHER_API_KEYS=

# NewsAPI - 100 requests/DAY per account: the tightest budget in the app.
# Cached per fallback tier for 12h. Pool 2-4 keys here if you pool anywhere.
NEWSAPI_KEY=
NEWSAPI_KEYS=

# Unsplash - 50 requests/hour (demo tier). Monument images are cached
# permanently in MongoDB, so this is rarely called after warm-up.
UNSPLASH_ACCESS_KEY=
UNSPLASH_ACCESS_KEYS=
UNSPLASH_SECRET_KEY=

# ---------------- Server configuration ----------------

PORT=3000
# Default 127.0.0.1. Use 0.0.0.0 when the host must accept external traffic -
# REQUIRED on Render, Fly.io, or any container platform, otherwise the health
# check cannot reach the process and the deploy fails.
HOST=127.0.0.1
NODE_ENV=development
# Comma-separated browser origins allowed to call the API. REQUIRED in
# production - an empty list rejects every browser origin.
#
# A single-label wildcard is supported, which matters on Cloudflare Pages: the
# stable alias never changes, but every deployment ALSO gets its own hostname
# (https://b9b14a49.geoswipe.pages.dev). One pattern covers all of them, so this
# never needs editing again:
#   ALLOWED_ORIGINS=https://geoswipe.pages.dev,https://*.geoswipe.pages.dev
#
# Matching is done on a parsed URL and only ONE label may vary, so
# geoswipe.pages.dev.evil.com and evil.com/#.geoswipe.pages.dev do not match.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174

# Warms the monument-image cache for a few sites shortly after boot. Set to
# false on a cold-starting free tier if you would rather not spend the startup
# time; images still populate lazily on first view.
PREWARM_MONUMENT_IMAGES=true
